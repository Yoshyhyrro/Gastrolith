%{ open Ast %}\n\n%token <string> IDENT\n%token <int> INT\n%token <string> STRING\n%token DCL IF THEN ELSE DO END SELECT WHEN OTHERWISE\n%token PLUS MINUS STAR SLASH EQ LT GT CONCAT\n%token SEMICOLON COMMA LPAREN RPAREN\n%token EOF\n\n%left PLUS MINUS\n%left STAR SLASH\n%left CONCAT\n\n%start <Ast.program> program\n%%\n\nprogram:\n  | stmts EOF { $1 }\n\nstmts:\n  | /* empty */ { [] }\n  | stmts stmt { $1 @ [$2] }\n\nstmt:\n  | DCL IDENT SEMICOLON { SDecl [$2] }\n  | IF expr THEN stmts END { SIf ($2, $4, None) }\n  | RETURN expr SEMICOLON { SReturn (Some $2) }\n  ;\n\nexpr:\n  | expr PLUS expr   { EBinOp ($1, "+", $3) }\n  | expr STAR expr   { EBinOp ($1, "*", $3) }\n  | INT              { EInt $1 }\n  | IDENT            { EIdent $1 }\n  | LPAREN expr RPAREN { $2 }\n  ;\n