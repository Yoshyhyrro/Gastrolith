{\nopen Token\nopen Printf\n\nlet kw_table = Hashtbl.create 17\nlet () =\n  List.iter (fun (s,t) -> Hashtbl.add kw_table s t)\n    [ ("dcl", DCL); ("if", IF); ("then", THEN); ("else", ELSE);\n      ("do", DO); ("end", END); ("select", SELECT); ("when", WHEN);\n      ("otherwise", OTHERWISE) ]\n\nlet keyword_or_ident s =\n  try Hashtbl.find kw_table (String.lowercase_ascii s)\n  with Not_found -> IDENT s\n\nlet preprocess = Preprocess.normalize_source\n\nlet lexbuf_from_string s = Lexing.from_string (preprocess s)\n}\n\nrule token = parse\n  | [' ' '\t' '\r' '\n']     { token lexbuf }\n  | "/*"                     { comment lexbuf }\n  | ['A'-'Z''a'-'z''_']['A'-'Z''a'-'z''0'-'9''_''$']* as id { keyword_or_ident id }\n  | ['0'-'9']+ as num        { INT (int_of_string num) }\n  | '\'' ([^'\\'']*) '\'' as s  { STRING (String.sub s 1 (String.length s - 2)) }\n  | "||"                     { CONCAT }\n  | "+"                      { PLUS }\n  | "-"                      { MINUS }\n  | "*"                      { STAR }\n  | "/"                      { SLASH }\n  | "="                      { EQ }\n  | "<"                      { LT }\n  | ">"                      { GT }\n  | ";"                      { SEMICOLON }\n  | ","                      { COMMA }\n  | "("                      { LPAREN }\n  | ")"                      { RPAREN }\n  | eof                      { EOF }\n  | _ as c                   { failwith (sprintf "不明な文字: %c" c) }\n\nand comment = parse\n  | "*/"                     { token lexbuf }\n  | eof                      { failwith "コメントが閉じていません" }\n  | _                        { comment lexbuf }\n