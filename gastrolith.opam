# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "PL/I card format parser and linter"
description: "PL/I card format parser and linter with modern warnings"
maintainer: ["yoshyhyrro"]
authors: ["yoshyhyrro"]
license: "MIT"
homepage: "https://github.com/yoshyhyrro/gastrolith"
bug-reports: "https://github.com/yoshyhyrro/gastrolith/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {build}
  "angstrom"
  "cmdliner"
  "str"
  "ppxlib"
  "menhir"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
